# Vanta OAuth Credentials
VANTA_CLIENT_ID=vci_YOUR_CLIENT_ID_HERE
VANTA_CLIENT_SECRET=vcs_YOUR_CLIENT_SECRET_HERE

# Obsidian Vault Path (relative to vault root)
OBSIDIAN_VAULT_PATH=Compliance/Vanta

# Azure Resources (used by deploy script)
AZURE_RESOURCE_GROUP=auracare-rg
AZURE_LOCATION=eastus
AZURE_STORAGE_ACCOUNT=auracarevantsync
AZURE_FUNCTION_APP=vanta-obsidian-sync
AZURE_CONTAINER_REGISTRY=auracareacr
